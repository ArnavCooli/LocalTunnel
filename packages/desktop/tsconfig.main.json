{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM"],
    "noEmitOnError": false
  },
  "include": ["src/main/**/*.ts", "src/services/**/*.ts", "src/setup/**/*.ts", "src/diagnostics/**/*.ts", "src/providers/**/*.ts"]
}
